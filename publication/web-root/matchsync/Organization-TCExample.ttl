@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://fhir.nmdp.org/ig/matchsync/Organization/TCExample> a fhir:Organization ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "TCExample"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "http://fhir.nmdp.org/ig/matchsync/StructureDefinition/transplantcenter" ;
       fhir:index 0 ;
       fhir:link <http://fhir.nmdp.org/ig/matchsync/StructureDefinition/transplantcenter>
     ] ;
     fhir:Meta.security [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "http://terminology.nmdp.org/codesystem/transplant-center" ] ;
       fhir:Coding.code [ fhir:value "tc_123" ]
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Organization TCExample</b></p><a name=\"TCExample\"> </a><a name=\"hcTCExample\"> </a><div style=\"display: inline-block; background-color: #fbffeb; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-transplantcenter.html\">TransplantCenter</a></p><p style=\"margin-bottom: 0px\">Security Label: </p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">My Transplant Center (http://terminology.nmdp.org/identifier/transplantcenter#000)</p><hr/></div>"
  ] ;
  fhir:Organization.identifier [
     fhir:index 0 ;
     fhir:Identifier.system [ fhir:value "http://terminology.nmdp.org/identifier/transplantcenter" ] ;
     fhir:Identifier.value [ fhir:value "000" ]
  ] ;
  fhir:Organization.name [ fhir:value "My Transplant Center"] .

# - ontology header ------------------------------------------------------------

<http://fhir.nmdp.org/ig/matchsync/Organization/TCExample.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

